import Sabrina.RoleChains.PathRegex

namespace Sabrina.RoleChains

namespace PathRegex

/-- The language generated by seeds with repeatable prefixes and suffixes.
    If the role is transitive, a nonempty sequence of such units is allowed. -/
def block (base pre post : PathRegex) (transitive : Bool) : PathRegex :=
  let unit := .seq (.star pre) (.seq base (.star post))
  if transitive then .seq unit (.star unit) else unit

private def UnitMatch (base pre post : PathRegex) (w : Word) : Prop :=
  ∃ p u s, Repeats pre.Matches p ∧ base.Matches u ∧ Repeats post.Matches s ∧
    w = p ++ (u ++ s)

private theorem unit_iff {base pre post : PathRegex} {w : Word} :
    (PathRegex.seq (.star pre) (.seq base (.star post))).Matches w ↔
      UnitMatch base pre post w := by
  constructor
  · rintro ⟨p, _, hp, ⟨u, s, hu, hs, rfl⟩, rfl⟩
    exact ⟨p,u,s,hp,hu,hs,rfl⟩
  · rintro ⟨p,u,s,hp,hu,hs,rfl⟩
    exact ⟨p,u ++ s,hp,⟨u,s,hu,hs,rfl⟩,rfl⟩

theorem block_congr {a b c a' b' c' : PathRegex} {t : Bool}
    (ha : ∀ w, a.Matches w ↔ a'.Matches w)
    (hb : ∀ w, b.Matches w ↔ b'.Matches w)
    (hc : ∀ w, c.Matches w ↔ c'.Matches w) (w : Word) :
    (block a b c t).Matches w ↔ (block a' b' c' t).Matches w := by
  have repeats {L K : Language} (h : ∀ w, L w → K w) {w : Word} (hw : Repeats L w) :
      Repeats K w := by
    induction hw with
    | nil => exact .nil
    | cons hu _ ih => exact .cons (h _ hu) ih
  have units : ∀ word, UnitMatch a b c word ↔ UnitMatch a' b' c' word := by
    intro word
    constructor
    · rintro ⟨p,u,s,hp,hu,hs,rfl⟩
      exact ⟨p,u,s,repeats (fun w => (hb w).mp) hp,(ha u).mp hu,
        repeats (fun w => (hc w).mp) hs,rfl⟩
    · rintro ⟨p,u,s,hp,hu,hs,rfl⟩
      exact ⟨p,u,s,repeats (fun w => (hb w).mpr) hp,(ha u).mpr hu,
        repeats (fun w => (hc w).mpr) hs,rfl⟩
  have units' (word : Word) := unit_iff.trans ((units word).trans unit_iff.symm)
  cases t
  · exact units' w
  · constructor
    · rintro ⟨u,v,hu,hv,rfl⟩
      exact ⟨u,v,(units' u).mp hu,repeats (fun w => (units' w).mp) hv,rfl⟩
    · rintro ⟨u,v,hu,hv,rfl⟩
      exact ⟨u,v,(units' u).mpr hu,repeats (fun w => (units' w).mpr) hv,rfl⟩

theorem block_base {base pre post : PathRegex} {t : Bool} {w : Word}
    (h : base.Matches w) : (block base pre post t).Matches w := by
  have hu : (PathRegex.seq (.star pre) (.seq base (.star post))).Matches w :=
    unit_iff.mpr ⟨[],w,[],.nil,h,.nil,by simp⟩
  cases t
  · exact hu
  · exact ⟨w,[],hu,.nil,by simp⟩

private theorem unit_prefix {base pre post : PathRegex} {u v : Word}
    (hu : pre.Matches u) (hv : UnitMatch base pre post v) :
    UnitMatch base pre post (u ++ v) := by
  obtain ⟨p,w,s,hp,hw,hs,rfl⟩ := hv
  exact ⟨u ++ p,w,s,.cons hu hp,hw,hs,by simp only [List.append_assoc]⟩

private theorem unit_suffix {base pre post : PathRegex} {u v : Word}
    (hu : UnitMatch base pre post u) (hv : post.Matches v) :
    UnitMatch base pre post (u ++ v) := by
  obtain ⟨p,w,s,hp,hw,hs,rfl⟩ := hu
  have hv' : Repeats post.Matches v := by
    simpa using Repeats.cons hv Repeats.nil
  exact ⟨p,w,s ++ v,hp,hw,hs.append hv',by simp only [List.append_assoc]⟩

theorem block_prefix {base pre post : PathRegex} {t : Bool} {u v : Word}
    (hu : pre.Matches u) (hv : (block base pre post t).Matches v) :
    (block base pre post t).Matches (u ++ v) := by
  cases t
  · exact unit_iff.mpr (unit_prefix hu (unit_iff.mp hv))
  · obtain ⟨p,q,hp,hq,rfl⟩ := hv
    exact ⟨u ++ p,q,unit_iff.mpr (unit_prefix hu (unit_iff.mp hp)),hq,
      by simp only [List.append_assoc]⟩

private theorem repeats_unit_suffix {base pre post : PathRegex} {v : Word}
    (hv : post.Matches v) {u : Word}
    (hu : Repeats (PathRegex.seq (.star pre) (.seq base (.star post))).Matches u)
    (hne : u ≠ []) :
    Repeats (PathRegex.seq (.star pre) (.seq base (.star post))).Matches (u ++ v) := by
  induction hu with
  | nil => exact (hne rfl).elim
  | @cons a b ha hb ih =>
    by_cases he : b = []
    · subst b
      have h := unit_iff.mpr (unit_suffix (unit_iff.mp ha) hv)
      simpa using Repeats.cons h Repeats.nil
    · simpa only [List.append_assoc] using Repeats.cons ha (ih he)

theorem block_suffix {base pre post : PathRegex} {t : Bool} {u v : Word}
    (hu : (block base pre post t).Matches u) (hv : post.Matches v) :
    (block base pre post t).Matches (u ++ v) := by
  cases t
  · exact unit_iff.mpr (unit_suffix (unit_iff.mp hu) hv)
  · obtain ⟨p,q,hp,hq,rfl⟩ := hu
    by_cases he : q = []
    · subst q
      exact ⟨p ++ v,[],unit_iff.mpr (unit_suffix (unit_iff.mp hp) hv),.nil,by simp⟩
    · exact ⟨p,q ++ v,hp,repeats_unit_suffix hv hq he,by simp only [List.append_assoc]⟩

theorem block_concat {base pre post : PathRegex} {u v : Word}
    (hu : (block base pre post true).Matches u)
    (hv : (block base pre post true).Matches v) :
    (block base pre post true).Matches (u ++ v) := by
  obtain ⟨a,b,ha,hb,rfl⟩ := hu
  obtain ⟨p,q,hp,hq,rfl⟩ := hv
  exact ⟨a,b ++ (p ++ q),ha,hb.append (.cons hp hq),List.append_assoc ..⟩

/-- Any language closed under the four block operations contains its compiled
    language. Together with closure, this identifies the least solution. -/
theorem block_least {base pre post : PathRegex} {t : Bool} {L : Language}
    (hb : ∀ {w}, base.Matches w → L w)
    (hp : ∀ {u v}, pre.Matches u → L v → L (u ++ v))
    (hs : ∀ {u v}, L u → post.Matches v → L (u ++ v))
    (ht : t = true → ∀ {u v}, L u → L v → L (u ++ v))
    {w : Word} (hw : (block base pre post t).Matches w) : L w := by
  have prepend {p u} (h : Repeats pre.Matches p) (hu : L u) : L (p ++ u) := by
    induction h with
    | nil => exact hu
    | cons h _ ih => simpa only [List.append_assoc] using hp h ih
  have extend {p} (h : Repeats post.Matches p) {u} (hu : L u) : L (u ++ p) := by
    induction h generalizing u with
    | nil => simpa using hu
    | cons h _ ih => simpa only [List.append_assoc] using ih (hs hu h)
  have unit {u} (h : (PathRegex.seq (.star pre) (.seq base (.star post))).Matches u) : L u := by
    obtain ⟨p,u,s,hp,hu,hs,rfl⟩ := unit_iff.mp h
    exact prepend hp (extend hs (hb hu))
  cases t
  · exact unit hw
  · obtain ⟨a,b,ha,hb,rfl⟩ := hw
    have finish {v} (h : Repeats (PathRegex.seq (.star pre) (.seq base (.star post))).Matches v)
        {u} (hu : L u) : L (u ++ v) := by
      induction h generalizing u with
      | nil => simpa using hu
      | cons h _ ih => simpa only [List.append_assoc] using ih (ht rfl hu (unit h))
    exact finish hb (unit ha)

end PathRegex

end Sabrina.RoleChains
